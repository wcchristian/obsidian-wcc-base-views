{
  "name": "obsidian-wcc-base-views",
  "version": "0.1.0",
  "description": "Table, List, Kanban, Calendar, and Timeline views for Obsidian Bases.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs prod",
    "watch": "node esbuild.config.mjs watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^5.48.0",
    "@typescript-eslint/parser": "^5.48.0",
    "esbuild": "^0.17.3",
    "eslint": "8.57.1",
    "obsidian": "1.12.3",
    "prettier": "3.6.2",
    "tslib": "^2.4.0",
    "typescript": "^4.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  }
}
