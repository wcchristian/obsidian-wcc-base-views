{
  "name": "obsidian-wcc-base-views",
  "version": "0.2.5",
  "description": "Table, List, Kanban, Calendar, and Timeline views for Bases.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs prod",
    "watch": "node esbuild.config.mjs watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src package.json --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run validate:release",
    "validate:release": "node scripts/validate-release.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "prettier": "3.6.2",
    "tslib": "^2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "overrides": {
    "obsidian": "$obsidian"
  }
}
